# -------------------------
# Flutter / Dart
# -------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Flutter generated env
*.kernel
*.dill
*.snapshot

# Pub lock
# For apps, keep pubspec.lock committed.
# Do NOT ignore pubspec.lock.

# -------------------------
# Android / Gradle
# -------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/*.jks
android/*.keystore
android/app/*.jks
android/app/*.keystore

# Android Studio
.idea/
*.iml

# Keep this ignored if using local SDK path
local.properties

# -------------------------
# iOS / macOS
# -------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/build/
ios/Runner.xcworkspace/
ios/Runner/GeneratedPluginRegistrant.*

macos/Flutter/ephemeral/
macos/Pods/
macos/Runner.xcworkspace/

# iOS signing
*.mobileprovision
*.cer
*.p12

# -------------------------
# Linux / Web build outputs
# -------------------------
linux/flutter/ephemeral/
web/.dart_tool/

# -------------------------
# Firebase
# -------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log

# Firebase local emulator data
firebase-export-*/
emulator-data/
*.local

# Firebase service account keys
*service-account*.json
*firebase-adminsdk*.json
serviceAccountKey.json

# Optional: ignore real Firebase client config for public GitHub
# If repo is public, keep these ignored and commit example files instead.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# -------------------------
# Cloud Functions
# -------------------------
functions/node_modules/
functions/lib/
functions/dist/
functions/.runtimeconfig.json
functions/firebase-debug.log
functions/npm-debug.log*
functions/yarn-debug.log*
functions/yarn-error.log*
functions/package-lock.json.tmp

# Functions env files
functions/.env
functions/.env.*
!functions/.env.example

# Keep this committed:
# functions/package.json
# functions/package-lock.json
# functions/tsconfig.json
# functions/src/

